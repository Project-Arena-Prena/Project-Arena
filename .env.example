# Supabase project URL — Project Settings > API. Public, shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key — public, RLS-constrained. Legacy anon keys also work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key — bypasses RLS. Server only. Never expose it to the client.
SUPABASE_SECRET_KEY=

# Legacy fallback while migrating to secret keys. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Restricted API key preferred over a secret key (rk_test_... / rk_live_...).
# Required Checkout + Refund permissions. Store as a sensitive Vercel env var.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — whsec_..., printed by `stripe listen` or the Dashboard.
STRIPE_WEBHOOK_SECRET=

# Absolute origin used for Stripe redirects, magic links, and share images. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails granted admin access. Also upserted into public.admins on sign-in.
ADMIN_EMAILS=

# Optional. Protects GET/POST /api/cron/reconcile (Vercel Cron sends Authorization: Bearer $CRON_SECRET).
CRON_SECRET=

# Optional salt mixed into IP/UA hashes. Never store raw IPs.
FRAUD_SALT=

# Optional. If unset, transactional email is mocked to the server log.
RESEND_API_KEY=
EMAIL_FROM=Project Arena <arena@localhost>

# ---------------------------------------------------------------------------
# Phase 3 — $PRENA utility layer
#
# $PRENA buys participation and unlocks utility. It can never buy rank, votes,
# score, or victory. Every value below is optional: with PRENA_MODE=mock (the
# default) the whole flow runs simulated, and card entry is unaffected either way.
# ---------------------------------------------------------------------------

# mock (default) — simulated balances, quotes, payments, and claims for development.
# onchain        — production. Requires the token, treasury, RPC, and price source below.
PRENA_MODE=mock
NEXT_PUBLIC_PRENA_MODE=mock

# Chain the token lives on. 31337 is the local dev default.
PRENA_CHAIN_ID=31337
NEXT_PUBLIC_PRENA_CHAIN_ID=31337
NEXT_PUBLIC_PRENA_CHAIN_NAME=Arena Devnet
NEXT_PUBLIC_PRENA_NATIVE_SYMBOL=ETH

# ERC-20 contract for $PRENA. Never hard-code this in application code.
PRENA_TOKEN_ADDRESS=
NEXT_PUBLIC_PRENA_TOKEN_ADDRESS=
PRENA_TOKEN_SYMBOL=PRENA
NEXT_PUBLIC_PRENA_TOKEN_SYMBOL=PRENA
PRENA_TOKEN_DECIMALS=18
NEXT_PUBLIC_PRENA_TOKEN_DECIMALS=18

# Where Arena entry payments are sent. Project Arena never custodies Builder keys.
PRENA_TREASURY_ADDRESS=

# Optional contract that settles reward claims. Without it, onchain claims are
# recorded and settled by an operator rather than paid out automatically.
PRENA_REWARD_DISTRIBUTOR_ADDRESS=

# Server-side RPC endpoint. Never shipped to the browser.
PRENA_RPC_URL=
# Public RPC + explorer used only for wallet network-switch prompts and tx links.
NEXT_PUBLIC_PRENA_RPC_URL=
NEXT_PUBLIC_PRENA_EXPLORER_URL=

# REQUIRED IN PRODUCTION. Trusted price source returning {"usd": <number>}.
# Without it, onchain mode refuses to quote — it must never fall back to a dev price.
PRENA_PRICE_SOURCE_URL=

# Development-only USD price per $PRENA. Ignored when PRENA_MODE=onchain.
PRENA_DEV_USD_PRICE=0.01

# How long a checkout quote stays spendable, in seconds.
PRENA_QUOTE_TTL_SECONDS=180

# Confirmations required before a token payment is accepted.
PRENA_MIN_CONFIRMATIONS=1

# Token perk thresholds, in whole $PRENA. Timing and cosmetics only —
# these can never affect Arena score, votes, or ranking.
PRENA_EARLY_REGISTRATION_MIN=10000
PRENA_VERIFIED_BUILDER_MIN=2500
PRENA_VERIFIED_MIN_ARENAS=1
