# Supabase project URL — Project Settings > API. Public, shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — public, RLS-constrained. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — bypasses RLS. Server only. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key — sk_test_... in development, sk_live_... in production.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — whsec_..., printed by `stripe listen` or the Dashboard.
STRIPE_WEBHOOK_SECRET=

# Absolute origin used for Stripe redirects and metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
